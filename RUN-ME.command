#!/bin/bash
#
# ============================================================================
#  RUN-ME.command  --  macOS 双击入口
# ============================================================================
#
#  作用：在你自己的电脑上把这套系统的证据链**重跑一遍**，跑完自动打开报告页。
#  这一步是【可选的】。不想跑、或者机器上没有 Python，直接双击 START-HERE.html
#  一样能看到全部内容 —— 那是一张静态网页，不需要 Python，也不需要联网。
#
# ----------------------------------------------------------------------------
#  🔴 双击时如果弹出「无法打开，因为它来自身份不明的开发者」
# ----------------------------------------------------------------------------
#
#  这是 macOS 的正常保护（Gatekeeper），不是文件坏了。从邮件或网盘下载的压缩包，
#  解压出来的可执行文件都会被打上「隔离」标记。绕过它只要一次，两种办法任选：
#
#    办法一（推荐，不用开终端）：
#        在**访达**里【右键点击】本文件（或按住 Control 点击）-> 选「打开」
#        -> 弹窗里再点一次「打开」。此后双击就正常了。
#        ⚠️ 必须走右键菜单。直接双击的那个弹窗上**没有**「打开」按钮，只能取消。
#
#    办法二（终端一条命令，用于整包解除）：
#        xattr -dr com.apple.quarantine "本文件夹的路径"
#
#  同样地，如果双击后提示「权限不够 / Permission denied」，说明压缩工具没保留
#  可执行权限，在终端里对本文件跑一次：  chmod +x RUN-ME.command
#
# ----------------------------------------------------------------------------
#  这个文件只做两件事：切到自己所在的目录、找一个够新的 Python。
#  真正干活的是 client/preflight.py，Windows 版 RUN-ME.bat 调的是同一个文件。
# ----------------------------------------------------------------------------

# 双击 .command 时 Terminal 的当前目录是**用户主目录**，不是本文件所在的目录 ——
# 不切过来的话，下面每一个相对路径都指向 ~，全部落空。
# 路径里有空格是常态（"我的下载"、"Desktop/客户 材料"），所以每一处都带引号。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SELF_DIR" || {
    echo "无法进入本文件所在的目录：$SELF_DIR"
    exit 1
}

PY_BIN=""
PY_ARGS=()

# 探测顺序 py -3 -> python3 -> python 与 RUN-ME.bat 保持一致，两个平台同一套语义。
# macOS 上通常没有 py，试一下无害；写在这里是为了两个入口的行为逐字对齐。
# 判据用 Python 自己算，不解析 `--version` 的输出 —— 那个格式各家发行版不一样。
# 这一小段 -c 代码在 Python 2 上也跑得起来（sys.version_info 元组比较，2/3 通用），
# 所以老 Python 会被干净地判负，而不是抛 SyntaxError。
probe() {
    local bin="$1"
    shift
    command -v "$bin" >/dev/null 2>&1 || return 1
    "$bin" "$@" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' \
        >/dev/null 2>&1 || return 1
    PY_BIN="$bin"
    PY_ARGS=("$@")
    return 0
}

pause_and_exit() {
    local rc="$1"
    # 双击运行时窗口会在脚本结束的一瞬间关掉（具体行为看「终端 -> 设置 -> 描述文件
    # -> Shell 退出时」怎么配，指望不上），客户什么都来不及看。所以自己停一下。
    # 只在标准输入是终端时停：`bash RUN-ME.command < /dev/null` 或被自动化脚本
    # 调用时不该卡住（scripts/client_smoke.py 走的就是那条路）。
    if [ -t 0 ]; then
        echo ""
        printf '按回车键关闭本窗口...'
        read -r _
        echo ""
    fi
    exit "$rc"
}

no_python() {
    cat <<'MSG'

================================================================
  这台电脑上没有找到 Python 3.10 或更高版本
================================================================

  这一步是【可选的】。它的作用是让你在自己的电脑上把证据链重跑一遍，
  亲眼确认报告里的数字不是我们写上去的。

  不装 Python 也不影响你看全部内容：
      回到这个文件夹，双击  START-HERE.html
  结论、全链路、每一步的证据都在里面。那是一张静态网页，
  不需要 Python，也不需要联网。

  想自己跑一遍的话：
      到 python.org 下载 Python 3.10 以上版本（macOS 版），
      装完重新双击本文件即可。

  （如果你确信已经装过 Python：macOS 自带的那个 python3 在没装过
    「命令行开发者工具」时只是个占位程序，跑起来会弹一个安装框。
    按提示装完，或者直接装 python.org 的官方版，都可以。）

MSG
    pause_and_exit 3
}

if [ ! -f "client/preflight.py" ]; then
    cat <<'MSG'

================================================================
  这个文件夹不完整
================================================================

  找不到 client/preflight.py。多半是压缩包只解压了一部分，
  或者只从压缩包里拖出了几个文件。

  请把整个 zip 完整解压一次，然后在解压出来的文件夹里双击本文件。

MSG
    pause_and_exit 2
fi

probe py -3 || probe python3 || probe python || no_python

"$PY_BIN" "${PY_ARGS[@]}" client/preflight.py "$@"
pause_and_exit "$?"
